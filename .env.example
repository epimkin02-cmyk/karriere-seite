# Öffentliche Basis-URL, ohne abschließenden Schrägstrich.
# Treibt Canonicals, Open-Graph-Bilder und die Sitemap.
NEXT_PUBLIC_SITE_URL=https://www.kutscher-stb.de

# --- Mailversand der beiden Formulare (Kontakt + Schnellbewerbung) ----------
# API-Key aus resend.com. UNPRÄFIXT lassen — ein NEXT_PUBLIC_-Name würde den
# Schlüssel in das Browser-Bundle schreiben und an jeden Besucher ausliefern.
RESEND_API_KEY=

# Absender. Die Domain muss bei Resend verifiziert sein (DNS-Einträge), ein
# Postfach dahinter braucht es nicht. Antworten laufen über Reply-To.
MAIL_FROM="Kutscher Website <website@kutscher-stb.de>"

# Postfach, in dem die Meldungen ankommen.
MAIL_TO=kanzlei@kutscher-stb.de
