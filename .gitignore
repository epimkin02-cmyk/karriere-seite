# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugin
!.yarn/sdks
!.yarn/versions

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit these. The application form's delivery provider key
# belongs here as an unprefixed server-only variable; anything named
# NEXT_PUBLIC_* is shipped to the browser and is not a secret.
.env
.env*.local
.env.production

# typescript
*.tsbuildinfo

# vercel
.vercel

# editors
.idea
.vscode/*
!.vscode/extensions.json
